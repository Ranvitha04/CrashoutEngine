# Doxyfile configuration for readable, modern docs

# Project basics
PROJECT_NAME           = "CRASHOUTS"
PROJECT_BRIEF          = "Team Crashouts Game Engine"
OUTPUT_DIRECTORY       = docs
GENERATE_HTML          = YES
GENERATE_LATEX         = NO

# Input files
INPUT                  = "projects/CrashoutEngine"
RECURSIVE              = YES
FILE_PATTERNS          = *.h *.hpp *.cpp *.md

# Parsing options
EXTRACT_ALL            = YES
EXTRACT_PRIVATE        = NO
EXTRACT_STATIC         = YES
EXTRACT_ANON_NSPACES   = YES

# Indexing / navigation
FULL_PATH_NAMES        = NO
INLINE_SOURCES         = YES
SOURCE_BROWSER         = YES
REFERENCES_RELATION    = YES
REFERENCES_LINK_SOURCE = YES
VERBATIM_HEADERS       = YES

# Sorting
SORT_MEMBER_DOCS       = YES
SORT_BRIEF_DOCS        = YES
SORT_GROUP_NAMES       = YES
ALPHABETICAL_INDEX     = YES

# Markdown & diagrams
MARKDOWN_SUPPORT       = YES
USE_MDFILE_AS_MAINPAGE = README.md
ENABLE_PREPROCESSING   = YES
MACRO_EXPANSION        = YES
EXPAND_ONLY_PREDEF     = NO

# Graphs and visuals
HAVE_DOT               = YES
DOT_GRAPH_MAX_NODES    = 50
DOT_TRANSPARENT        = YES
CALL_GRAPH             = YES
CALLER_GRAPH           = YES
CLASS_DIAGRAMS         = YES
DOT_IMAGE_FORMAT       = svg

# HTML styling
GENERATE_TREEVIEW      = YES
DISABLE_INDEX          = NO
GENERATE_LATEX         = NO
HTML_COLORSTYLE_HUE    = 220
HTML_COLORSTYLE_SAT    = 100
HTML_COLORSTYLE_GAMMA  = 80

# Let’s use Doxygen’s modern color style as a base
HTML_COLORSTYLE        = DARK

